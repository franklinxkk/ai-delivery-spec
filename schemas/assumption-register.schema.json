{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/franklinxkk/ai-delivery-spec/schemas/assumption-register.schema.json",
  "title": "AI Delivery Spec Assumption Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "stage", "register_id", "project_id", "version", "status", "assumptions", "resume_context"],
  "properties": {
    "schema_version": {"const": "5.4.0"},
    "artifact": {"const": "assumption_register"},
    "stage": {"const": "explore"},
    "register_id": {"type": "string", "pattern": "^ASM-REGISTER-[A-Z0-9-]+$"},
    "project_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active", "closed", "superseded"]},
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "category", "option_refs", "evidence_refs", "validation_method", "success_threshold", "failure_action", "owner", "status", "due_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^ASM-[A-Z0-9-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "category": {"enum": ["desirability", "viability", "feasibility", "usability", "compliance", "data"]},
          "option_refs": {"type": "array", "items": {"type": "string", "pattern": "^OPT-[A-Z0-9-]+$"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "validation_method": {"type": "string", "minLength": 1},
          "success_threshold": {"type": "string", "minLength": 1},
          "failure_action": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"enum": ["untested", "testing", "supported", "rejected", "expired"]},
          "due_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "resume_context": {"$ref": "#/$defs/resumeContext"}
  },
  "$defs": {
    "resumeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_stages", "prior_artifacts", "open_threads", "next_stage_options"],
      "properties": {
        "completed_stages": {"type": "array", "items": {"enum": ["frame", "explore", "intake", "clarify", "specify", "review", "baseline", "change", "acceptance"]}},
        "prior_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "stage"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "stage": {"enum": ["frame", "explore", "intake", "clarify", "specify", "review", "baseline", "change", "acceptance"]}
            }
          }
        },
        "open_threads": {"type": "array", "items": {"type": "string"}},
        "next_stage_options": {"type": "array", "items": {"enum": ["frame", "explore", "intake", "clarify", "specify", "review", "baseline", "change", "acceptance"]}}
      }
    }
  }
}
