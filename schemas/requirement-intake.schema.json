{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-delivery-spec/requirement-intake.schema.json",
  "title": "AI Delivery Spec 5.4 Requirement Intake",
  "type": "object",
  "required": [
    "schema_version", "artifact", "stage", "requirement_id", "title", "outcome",
    "owner", "document_language", "source_refs", "value", "priority", "complexity",
    "target_iteration", "dependencies", "value_evidence", "roles", "modules"
  ],
  "properties": {
    "schema_version": {"const": "5.4.0"},
    "artifact": {"const": "requirement_intake"},
    "stage": {"const": "intake"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "document_language": {"type": "string", "minLength": 2},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}},
    "artifact_mode": {"enum": ["direct", "card", "prd"]},
    "risk_facets": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["state", "authority", "integration", "metric", "permission", "privacy", "regulated", "migration", "irreversible", "irreversible_ai_write", "strong_audit"]}
    },
    "evidence_level": {"enum": ["static", "browser", "real_system", "customer_acceptance"]},
    "value": {"enum": ["low", "medium", "high", "critical"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "complexity": {
      "type": "object",
      "required": ["band", "dimensions"],
      "properties": {
        "band": {"enum": ["S", "M", "L", "XL"]},
        "dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "target_iteration": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "value_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "roles": {"type": "array", "items": {"type": "string", "pattern": "^ROLE-[A-Z0-9-]+$"}},
    "modules": {"type": "array", "items": {"type": "string", "pattern": "^MOD-[A-Z0-9-]+$"}},
    "integrations": {"type": "array", "items": {"type": "string"}},
    "states": {"type": "array", "items": {"type": "string"}},
    "cross_role_handoffs": {"type": "array", "items": {"type": "string"}},
    "data_submission": {"type": "boolean"},
    "data_reporting": {"type": "boolean"},
    "metric_caliber": {"type": "boolean"},
    "batch_io": {"type": "boolean"},
    "approval": {"type": "boolean"},
    "audit_required": {"type": "boolean"},
    "irreversible_write": {"type": "boolean"},
    "version_compatibility": {"type": "boolean"},
    "reversible": {"type": "boolean"},
    "cross_module_state": {"type": "boolean"},
    "sensitive_data": {"type": "boolean"},
    "compliance": {"type": "boolean"},
    "migration": {"type": "boolean"},
    "customer_acceptance": {"type": "boolean"},
    "ai_behavior": {"type": "boolean"},
    "ai_centrality": {"enum": ["none", "incidental", "supporting", "core"]},
    "ai_write_scope": {"enum": ["none", "read_only", "draft_only", "consequential_write"]},
    "ai_reversible": {"type": "boolean"},
    "ai_human_gate": {"type": "boolean"},
    "urgent": {"type": "boolean"},
    "blocked_dependency": {"type": "boolean"},
    "ambiguity": {"enum": ["low", "medium", "high"]}
  },
  "additionalProperties": false
}
