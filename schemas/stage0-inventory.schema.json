{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/franklinxkk/ai-delivery-spec/schemas/stage0-inventory.schema.json",
  "title": "AI Delivery Spec Stage 0 Brownfield Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "items"],
  "properties": {
    "schema_version": { "const": "5.4.1" },
    "inventory_id": { "type": "string", "pattern": "^INV-[A-Z0-9-]+$" },
    "inventory_status": {
      "enum": ["in_progress", "inventory_complete"],
      "description": "inventory_complete 只证明所有观察项有来源和分类，不批准推断行为，也不证明目标设计"
    },
    "target_status": {
      "type": "string",
      "description": "声明 baseline_ready 前，全部 inferred 项必须已批量确认、否决或转未知"
    },
    "baseline_requirement_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" },
      "uniqueItems": true,
      "description": "已批准正向需求基线；声明后反推观察项必须使用 INV-*，不得另造 REQ-*"
    },
    "review_batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^RBATCH-[A-Z0-9-]+$" },
          "owner": { "type": "string", "minLength": 1 },
          "scope": { "type": "string" },
          "status": { "enum": ["open", "confirmed", "rejected", "deferred"] }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "source_ref", "source_location", "classification"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "已有正向需求基线时必须使用 INV-*，不得另造第二组 REQ-*"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "view / action / handler / state / role / object / field / metric / handoff 等盘点对象类型"
          },
          "source_ref": { "type": "string", "minLength": 1 },
          "source_location": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["confirmed", "inferred", "unknown", "defect_candidate"] },
          "core_behavior": { "type": "boolean" },
          "disposition": {
            "enum": ["adopt_page", "inherit_layout", "rebuild_interaction", "reuse_component", "discard"],
            "description": "存量页面处置方式：adopt_page 整页直接采用；inherit_layout 保留布局重做视觉；rebuild_interaction 保留业务流程重做交互；reuse_component 仅复用局部组件；discard 废弃重画。5.4.1 起建议每个 view 类条目必填；缺失时按未定处置对待，不得默认采用"
          },
          "mapping_status": { "enum": ["mapped", "unmapped", "not_applicable"] },
          "target_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" },
            "uniqueItems": true
          },
          "review_batch_ref": { "type": "string", "pattern": "^RBATCH-[A-Z0-9-]+$" },
          "target_requirement_ref": {
            "type": "string",
            "description": "defect_candidate 未经 DEC/CHG 不得填写此字段升级为目标需求"
          },
          "unknown": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^UNK-[A-Z0-9-]+$" },
              "priority": { "enum": ["P0", "P1", "P2"] },
              "owner": { "type": "string", "minLength": 1 },
              "blocks_stage": { "enum": ["clarify", "specify", "review", "baseline", "implementation", "acceptance"] }
            }
          }
        }
      }
    },
    "critical_chains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criticalChain" },
      "description": "只登记当前范围内必须走通的关键存量链；缺失表示尚未做结构化可达性盘点，不表示不存在断裂"
    },
    "reachability_breaks": {
      "type": "array",
      "items": { "$ref": "#/$defs/reachabilityBreak" },
      "uniqueItems": true,
      "description": "关键链的已观察断裂或未知项清单；允许在所有链均有证据证明可达时为空，但不得用空数组替代未完成评估"
    },
    "canonical_candidates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "conflict_decision_ref": {
      "type": "string",
      "pattern": "^DEC-CONFLICT-[A-Z0-9-]+$",
      "description": "多个候选基线必须由 DEC-CONFLICT-* 裁决"
    }
  },
  "$defs": {
    "refArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "outputFacet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refs"],
      "properties": {
        "status": { "enum": ["observed", "missing", "unknown", "not_applicable"] },
        "refs": { "$ref": "#/$defs/refArray" },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "observed" } }, "required": ["status"] },
          "then": { "properties": { "refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "not_applicable" } }, "required": ["status"] },
          "then": { "required": ["note"] }
        }
      ]
    },
    "nextEntryFacet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refs"],
      "properties": {
        "status": { "enum": ["observed", "missing", "unknown", "terminal"] },
        "refs": { "$ref": "#/$defs/refArray" },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "observed" } }, "required": ["status"] },
          "then": { "properties": { "refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "terminal" } }, "required": ["status"] },
          "then": { "required": ["note"] }
        }
      ]
    },
    "nextGuardFacet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refs"],
      "properties": {
        "status": { "enum": ["observed", "missing", "unknown", "not_applicable"] },
        "refs": { "$ref": "#/$defs/refArray" },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "observed" } }, "required": ["status"] },
          "then": { "properties": { "refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "not_applicable" } }, "required": ["status"] },
          "then": { "required": ["note"] }
        }
      ]
    },
    "recoveryPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entry_refs", "guard_refs", "outcome_refs", "break_refs"],
      "properties": {
        "status": { "enum": ["observed", "broken", "unknown", "not_applicable"] },
        "entry_refs": { "$ref": "#/$defs/refArray" },
        "guard_refs": { "$ref": "#/$defs/refArray" },
        "outcome_refs": { "$ref": "#/$defs/refArray" },
        "break_refs": { "$ref": "#/$defs/refArray" },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_location": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["observed", "broken", "unknown"] } }, "required": ["status"] },
          "then": { "required": ["source_ref", "source_location"] }
        },
        {
          "if": { "properties": { "status": { "const": "not_applicable" } }, "required": ["status"] },
          "then": { "required": ["note"] }
        }
      ]
    },
    "criticalChainLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action_ref", "processing_refs", "outputs", "next_entry", "next_guard", "reachability", "source_ref", "source_location", "break_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-LINK-[A-Z0-9-]+$" },
        "action_ref": { "type": "string", "minLength": 1 },
        "processing_refs": { "$ref": "#/$defs/refArray" },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["objects", "states", "versions", "identities"],
          "properties": {
            "objects": { "$ref": "#/$defs/outputFacet" },
            "states": { "$ref": "#/$defs/outputFacet" },
            "versions": { "$ref": "#/$defs/outputFacet" },
            "identities": { "$ref": "#/$defs/outputFacet" }
          }
        },
        "next_entry": { "$ref": "#/$defs/nextEntryFacet" },
        "next_guard": { "$ref": "#/$defs/nextGuardFacet" },
        "reachability": { "enum": ["reachable", "broken", "unknown", "terminal"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_location": { "type": "string", "minLength": 1 },
        "break_refs": { "$ref": "#/$defs/refArray" }
      }
    },
    "criticalChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_ref", "source_location", "assessment_status", "links", "recovery_paths", "break_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-CHAIN-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_location": { "type": "string", "minLength": 1 },
        "assessment_status": { "enum": ["in_progress", "assessed"] },
        "links": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criticalChainLink" } },
        "recovery_paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failure", "return", "retry", "compensation"],
          "properties": {
            "failure": { "$ref": "#/$defs/recoveryPath" },
            "return": { "$ref": "#/$defs/recoveryPath" },
            "retry": { "$ref": "#/$defs/recoveryPath" },
            "compensation": { "$ref": "#/$defs/recoveryPath" }
          }
        },
        "break_refs": { "$ref": "#/$defs/refArray" }
      }
    },
    "reachabilityBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chain_ref", "path_kind", "classification", "source_ref", "source_location", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-BREAK-[A-Z0-9-]+$" },
        "chain_ref": { "type": "string", "pattern": "^INV-CHAIN-[A-Z0-9-]+$" },
        "link_ref": { "type": "string", "pattern": "^INV-LINK-[A-Z0-9-]+$" },
        "path_kind": { "enum": ["processing", "object", "state", "version", "identity", "next_entry", "next_guard", "failure", "return", "retry", "compensation"] },
        "classification": { "enum": ["unknown", "defect_candidate"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_location": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "unknown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "priority", "owner", "blocks_stage"],
          "properties": {
            "id": { "type": "string", "pattern": "^UNK-[A-Z0-9-]+$" },
            "priority": { "enum": ["P0", "P1", "P2"] },
            "owner": { "type": "string", "minLength": 1 },
            "blocks_stage": { "enum": ["clarify", "specify", "review", "baseline", "implementation", "acceptance"] }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["critical_chains"] },
      "then": { "required": ["reachability_breaks"] }
    }
  ]
}
